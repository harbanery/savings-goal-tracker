// Prisma schema for Savings Goal Tracker (Monthly Budget Tracker)
// Datasource URL dibaca dari DATABASE_URL di .env

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Satu catatan pembelian/pengeluaran dalam satu siklus bulanan.
model Purchase {
  /// CUID identifier
  id        String   @id @default(cuid())
  /// Nama pembelian, mis. "Makan siang", "Bensin", "Spotify"
  name      String
  /// ID subkategori/unit pencatatan (mis. "kos", "gopay-ojol",
  /// "jenius-langganan"). Total kategori/wadah = akumulasi subkategorinya.
  /// ID kategori lama (mis. "cash-dompet", "langganan") tetap tersimpan
  /// dan dipetakan otomatis di application layer (LEGACY_ALIASES).
  categoryId String
  /// Jumlah biaya (Decimal untuk presisi mata uang)
  amount    Decimal  @db.Decimal(14, 2)
  /// Catatan opsional
  note      String   @default("")
  /// Tanggal pembelian (menentukan siklus bulan mana pembelian ini masuk)
  date      DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@map("Purchase")
}

/// Langganan push notification dari browser.
model PushSubscriptions {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  /// Keys untuk enkripsi push: { p256dh, auth }
  keys      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("PushSubscriptions")
}
